# Only for your own local/test Medusa instance, never a production shop
MEDUSA_URL=http://localhost:9000
MEDUSA_PUBLISHABLE_KEY=
MEDUSA_REGION_ID=
# Service is disabled if empty. NVIDIA uses an OpenAI-compatible interface.
LLM_API_KEY=
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# KB index path and settings
INDEX_FILE=data/index.json
RAG_TOP_K=5
# For dense retrieval, run scripts/build_index.py --backend chroma
RAG_BACKEND=lexical
CHROMA_DIR=data/chroma
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
DB_FILE=data/commerceops.sqlite3
MAX_AGENT_STEPS=5
MAX_FETCH_PAGES=150
# Can only enable eBay harvesting after checking robots/terms
ALLOW_EBAY_COLLECTION=false

MAX_TOOL_CALLS=8
STORE_RETURNS_ENABLED=false
RAG_MIN_SCORE=0.12
MLFLOW_TRACKING_URI=sqlite:///data/mlflow.sqlite3
